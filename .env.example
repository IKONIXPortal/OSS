PORT=3000
NODE_ENV=production
TIME_ZONE=Asia/Manila
PUBLIC_BASE_URL=https://your-ikonix-service.example.com

# GitHub JSON synchronization. The data repository MUST be private.
GITHUB_SYNC_ENABLED=false
GITHUB_DATA_REPO=IKONIXPortal/OSS
GITHUB_DATA_BRANCH=main
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false
REQUIRE_PRIVATE_DATA_REPO=true

# Telegram bot / webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_KEY=

# Email OTP and notification delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=IKONIX Portal <no-reply@example.com>

# Persistent runtime paths (mount these on persistent storage in production)
RUNTIME_STATE_FILE=.runtime/state.json
UPLOAD_DIR=public/uploads

